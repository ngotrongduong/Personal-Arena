{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '--- docs/STATUS.md (top) ---'; head -n 40 docs/STATUS.md 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/read_guard.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/read_guard.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "bashOutputMaxChars": 15000,
  "skillOverrides": {
    "anthropic-skills:algorithmic-art": "off",
    "anthropic-skills:brand-guidelines": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:canvas-design": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:doc-coauthoring": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:internal-comms": "off",
    "anthropic-skills:learn": "off",
    "anthropic-skills:mcp-builder": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:slack-gif-creator": "off",
    "anthropic-skills:theme-factory": "off",
    "anthropic-skills:web-artifacts-builder": "off",
    "anthropic-skills:xlsx": "off"
  }
}
